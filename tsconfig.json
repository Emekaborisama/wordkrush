{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true
  },
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    // The Reddit app is a separate TypeScript project with its own compiler
    // options — it needs the `browser` resolution condition for
    // `@devvit/web/client`, which this Expo config resolves as `react-native`.
    // Typecheck it with `npm --prefix reddit run test:types`.
    "reddit"
  ]
}
