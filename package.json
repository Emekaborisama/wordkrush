{
  "name": "wordkrush",
  "version": "0.8.28",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && node scripts/patch-web-head.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "npm run check:docs && npm run typecheck && npm run test",
    "test:validator": "cd validator && uv run --extra dev python -m pytest -q",
    "smoke": "cd validator && uv run python -m smoke.run_smoke",
    "check:all": "npm run check && npm run test:validator",
    "pipeline:ingest": "tsx --env-file=.env pipeline/ingest.ts",
    "pipeline:preview": "tsx pipeline/preview-category.ts",
    "pipeline:rotate": "tsx pipeline/rotate-wikipedia-popularity.ts",
    "pipeline:reservoir": "tsx pipeline/build-wikipedia-reservoir.ts",
    "pipeline:export": "tsx --env-file=.env pipeline/export-snapshot.ts",
    "pipeline:wordfall": "tsx pipeline/build-wordfall-dictionary.ts",
    "auth:ensure-test-player": "tsx --env-file=.env pipeline/ensure-test-player.ts",
    "email:weekly": "tsx --env-file=.env pipeline/player-email.ts",
    "serve:web": "node server/serve.mjs",
    "reddit:install": "npm --prefix reddit install",
    "reddit:types": "npm --prefix reddit run test:types",
    "reddit:build": "npm --prefix reddit run build",
    "reddit:dev": "npm --prefix reddit run dev",
    "release:notes": "node scripts/changelog-notes.mjs --from-package"
  },
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@lottiefiles/dotlottie-react": "^0.13.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~57.0.13",
    "expo-audio": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "lottie-react-native": "~7.3.8",
    "posthog-react-native": "^4.63.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "hono": "4.12.32",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
