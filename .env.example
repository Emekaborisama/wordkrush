# Copy to .env and fill in real values. NEVER commit .env.
# From Supabase project settings → API.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SECRET key: server/pipeline use ONLY. Never expose to the app.
# Never rename with an EXPO_PUBLIC_ prefix — Expo embeds those in the client bundle.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Client-safe copies. ONLY EXPO_PUBLIC_* variables are inlined into the app
# bundle — that is exactly why the SECRET key must never carry this prefix.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PostHog client configuration. The project token is intentionally public;
# analytics still remains disabled until the player explicitly opts in.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Userback feedback widget (web build only). The access token identifies the
# Userback project, not the account — it is public the same way the PostHog
# project token is. Leave blank to ship without the widget; the drawer then
# hides its "Send feedback" entry rather than offering a dead one.
# Native (iOS/Android) needs a separate Mobile SDK key and is not wired up yet.
EXPO_PUBLIC_USERBACK_TOKEN=

# Local/AI test player. Confirmed ordinary Auth user, not a service-role
# substitute. Agents may read these names from .env for local API tests.
# Never print, commit, or prefix with EXPO_PUBLIC_.
# Create or refresh with: npm run auth:ensure-test-player
TEST_PLAYER_EMAIL=
TEST_PLAYER_PASSWORD=
TEST_PLAYER_USERNAME=

# OpenAI — used ONLY by the offline validator service (validator/).
# Never called by the game at runtime. No spaces around "=".
OPENAI_API_KEY=

# OpenRouter — Tuesday player-email draft (pipeline/player-email.ts). SECRET.
# Never EXPO_PUBLIC_ and never Railway. GitHub Environment `best-games` needs
# OPENROUTER_API_KEY; base URL and model are optional.
OPENROUTER_API_KEY=
# Optional. Defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=
# Optional. Defaults to openai/gpt-4o-mini
OPENROUTER_EMAIL_MODEL=

# Resend — weekly player Broadcasts (pipeline/player-email.ts). SECRET.
# Never EXPO_PUBLIC_ and never Railway: this key can send mail to every
# signed-in player. GitHub Environment `best-games` needs the same names.
# Verify wordkrush.com in the Resend dashboard first.
RESEND_API_KEY=
# Optional. Defaults to WordKrush <noreply@wordkrush.com>
RESEND_FROM=
# Optional. Defaults to finding or creating the "WordKrush players" segment.
RESEND_SEGMENT_ID=

# Optional extra Search Console HTML-tag token. The HTML-file method is already
# shipped: assets/googled8072618779c67b2.html is copied to dist/ at build time.
# Leave blank unless you also want a <meta name="google-site-verification"> tag.
GOOGLE_SITE_VERIFICATION=
